# Release build environment (Fastlane + --dart-define). Copy to your CI/release
# host; never commit real values.

# Runtime config injected via --dart-define (bootstrap.dart AppConfig)
ENGINE_BASE_URL=https://engine.example.com
SUPABASE_URL=
SUPABASE_ANON_KEY=

# iOS (TestFlight)
APPLE_ID=
TEAM_ID=

# Android release signing (android/app/build.gradle.kts)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Play upload (fastlane.json_key_file)
PLAY_JSON_KEY=
